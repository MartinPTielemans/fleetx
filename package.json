{
  "name": "@fleetx/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^24.13.1"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "fleetx": "node apps/cli/src/bin.ts",
